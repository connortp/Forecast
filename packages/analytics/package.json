{
  "name": "@forecast/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, privacy-first PostHog wrapper shared by Forecast's web app, marketing site and (later) iOS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./privacy": "./src/privacy.ts"
  },
  "scripts": {
    "build": "esbuild src/browser.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/forecast-analytics.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "posthog-js": "^1.441.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
